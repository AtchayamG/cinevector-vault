# Runtime Mode: 'live' for real ClickHouse Cloud + Gemini calls, 'demo' for local deterministic fixtures
RUNTIME_MODE=demo

# Google Gemini Configuration
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.7-flash

# Server Configuration
PORT=8001
HOST=0.0.0.0
DEBUG=false
ENABLE_MOCK_FALLBACK=false

# ClickHouse Cloud Configuration
# HTTP Port: 8123 (unencrypted) or 8443 (TLS/HTTPS - recommended for ClickHouse Cloud)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cinevector_vault
CLICKHOUSE_SECURE=true

# Official mcp-clickhouse Server Transport Settings
# The Python MCP client manages a local stdio session launching `mcp-clickhouse`
# or `python -m mcp_clickhouse.main` with the environment variables above.
CLICKHOUSE_MCP_ENDPOINT=http://localhost:8010/mcp
