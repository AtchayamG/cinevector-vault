# Runtime Mode: 'live' for real ClickHouse Cloud + Gemini calls, 'demo' for local deterministic fixtures
RUNTIME_MODE=demo

# Google Gemini Configuration
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash

# Server Configuration
PORT=8001
HOST=0.0.0.0
DEBUG=false
ENABLE_MOCK_FALLBACK=true

# ClickHouse Cloud / MCP Server Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cinevector_vault
CLICKHOUSE_SECURE=true
CLICKHOUSE_MCP_ENDPOINT=http://localhost:8010/mcp
